<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Login - SIAKAD PRO Node.js</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #0f172a; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .card-login { background: white; border-radius: 20px; width: 100%; max-width: 400px; padding: 30px; }
    </style>
</head>
<body>
    <div class="card-login shadow-lg">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-primary">SIAKAD NODE.JS</h3>
            <p class="text-muted small">Masuk sesuai peran akun Anda</p>
        </div>
        <% if (msg) { %>
            <div class="alert alert-danger p-2 small text-center"><%= msg %></div>
        <% } %>
        <form action="/login" method="POST">
            <div class="mb-3">
                <label class="form-label fw-bold">Username</label>
                <input type="text" name="username" class="form-control" placeholder="admin / guru / siswa" required>
            </div>
            <div class="mb-3">
                <label class="form-label fw-bold">Password</label>
                <input type="password" name="password" class="form-control" placeholder="Masukkan password" required>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Masuk Portal</button>
        </form>
        <div class="mt-4 p-2 bg-light rounded text-center small text-muted">
            <b>Info Login Cepat:</b><br>
            Admin: <code>admin</code> / <code>admin</code><br>
            Guru: <code>guru</code> / <code>guru</code><br>
            Siswa: <code>siswa</code> / <code>siswa</code>
        </div>
    </div>
</body>
</html>